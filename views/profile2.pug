extends layout

block content
  .container
    // Welcome Header
    if user
      .welcome-header.mb-4
        .row
          .col-12
            .welcome-card
              .welcome-content
                .welcome-row
                  h2.welcome-title Welcome back, #{user.user_metadata && user.user_metadata.first_name ? user.user_metadata.first_name : user.name || 'User'}!
                  // Only show tier information for customer flows, not partner flows
                  if title !== 'Partner Portal'
                    .subscription-info
                      .subscription-badge(class=`subscription-${userTier}`)
                        span.subscription-icon
                          if userTier === 'premium'
                            | ⭐
                          else if userTier === 'subscriber'
                            | 🔹
                          else
                            | 🔓
                        span.subscription-text #{userTier.charAt(0).toUpperCase() + userTier.slice(1)} Tier

    if user
      .row.g-4
        // Left Column - User Information & Registered Devices
        .col-md-6
          // User Information Card
          .card.shadow-sm.mb-4
            .card-body
              h4.profile.mb-3 User Information
              .profile-section
                p
                  strong Name:
                  | #{(user.user_metadata && user.user_metadata.first_name ? user.user_metadata.first_name : '') + ' ' + (user.user_metadata && user.user_metadata.last_name ? user.user_metadata.last_name : '') || 'MyOrg Member'}
                  //#{user.user_metadata.first_name + " " + user.user_metadata.last_name || 'MyOrg Member'}
                p
                  strong Email: 
                  | #{user.email || 'Not available'}
                p
                  strong Last Login: 
                  | #{user.last_login || 'Not available'}
          
          // Recent Panels Card
          .card.shadow-sm.mb-4
            .card-body
              h4.profile.mb-3 Panel Enrollment

              if hasActivePanel
                .panel-status.mb-3
                  .alert.alert-success
                    i.fas.fa-check-circle.me-2
                    strong Your Active Panels (#{panelInfo.totalPanels})
                    p.mb-2.mt-1 You are currently enrolled in #{panelInfo.totalPanels} panel#{panelInfo.totalPanels !== 1 ? 's' : ''}.
                
                if panelInfo.panels && panelInfo.panels.length > 0
                  .row
                    each panel in panelInfo.panels
                      .col-md-6.mb-3
                        .card.border-0.shadow-sm
                          .card-body
                            .d-flex.align-items-center.mb-2
                              i(class=panel.icon style=`color: ${panel.color}; font-size: 1.5rem; margin-right: 10px;`)
                              h6.mb-0= panel.name
                            p.small.text-muted.mb-2= panel.description
                            .d-flex.justify-content-between.align-items-center
                              .rewards
                                span.badge.bg-primary.me-1 $#{panel.rewards.base} base
                                if panel.rewards.bonus
                                  span.badge.bg-warning $#{panel.rewards.bonus} bonus
                              .status
                                span.badge.bg-success Active
                  .text-center.mt-3
                    a.btn.btn-outline-primary(href=title === 'Partner Portal' ? '/partners/panels' : '/panels')
                      i.fas.fa-plus.me-2
                      | Join More Panels
                else
                  p.text-muted No active panels found.
              else
                .panel-claim.mb-3
                  .alert.alert-info
                    i.fas.fa-info-circle.me-2
                    strong Join Nielsen Panels
                    p.mb-2.mt-1 You're not currently enrolled in any consumer panels. Choose from multiple panel types and start earning rewards!
                    .d-flex.gap-2
                      a.btn.btn-primary.btn-sm(href=title === 'Partner Portal' ? '/partners/panels' : '/panels')
                        i.fas.fa-chart-line.me-2
                        | Browse Available Panels
                      button.btn.btn-outline-secondary.btn-sm#refreshPanelBtn
                        i.fas.fa-sync-alt.me-2
                        | Refresh Status
          
          // Section Separator
          .section-separator
            hr.separator-line
            .separator-text
              span 
          
          // Registered MFA Card
          .card.shadow-sm
            .card-body
              h4.profile.mb-3 Registered MFA Factors
              
              h6 #{factors.id}

              if factors && factors.length > 0
                ul.list-unstyled
                  each factor in factors
                    li.device-item.mb-2
                      .device-card.p-2.border.rounded
                        p.mb-1
                          strong Factor Type: 
                          | #{factor.type || 'Type'}
                        p.mb-0
                          strong Is Verified: 
                          | #{factor.confirmed || 'N/A'}
              else
                p.text-muted No registered Factors.
                .text-center.mt-4
                  button.btn.btn-primary(type="button" onclick=`window.location.href='${issuerUrl}/authorize?audience=${mgmtUrl}/userinfo&scope=openid&response_type=code&client_id=${clientId}&redirect_uri=${appUrl}/profile&state=qwhgdiuqwhsw2hdue2bhfdiul2hdlweiuhde&acr_values=http://schemas.openid.net/pape/policies/2007/06/multi-factor'`) Click here to enroll
            
            // MFA Opt-in Setting
            .mfa-optin-section.mt-4
              .form-check
                input.form-check-input(
                  type="checkbox", 
                  id="mfaOptin", 
                  checked=user.user_metadata && user.user_metadata.optinmfa === 'true',
                  onclick="toggleMfaOptin(this)"
                )
                label.form-check-label(for="mfaOptin")
                  strong Require MFA on Login
                    p.form-text.text-muted
                      | When enabled, you will be prompted for multi-factor authentication on every login.



        // Right Column - Editable Profile Form
        .col-md-6
          .card.shadow-sm
            .card-body
              h4.profile.mb-3 Edit Profile
              
              // Success message for profile updates
              if updateSuccess
                .alert.alert-success.alert-dismissible.fade.show.mb-3#profileUpdateSuccess
                  strong ✓ Profile Updated Successfully!
                  | Your profile has been updated with MFA verification.
                  button.btn-close(type="button" data-bs-dismiss="alert")

              form#profileForm(action="/profile" method="POST")
              
                .mb-3
                  label(for="first_name") First Name
                  input#given_name.form-control(
                    type="text"
                    name="first_name"
                    value=(user && user.user_metadata && user.user_metadata.first_name) ? user.user_metadata.first_name : ''
                    placeholder="Enter your first name"
                  )
                  
                .mb-3
                  label(for="last_name") Last Name
                  input#family_name.form-control(
                    type="text"
                    name="last_name"
                    value=(user && user.user_metadata && user.user_metadata.last_name) ? user.user_metadata.last_name : ''
                    placeholder="Enter your last name"
                  )
                  
                .mb-3
                  label(for="email") Email
                  input#email.form-control(type="email" name="email" value=user.email placeholder="Enter your email")
                
                
                //h5.mt-4 Consent Preferences
                //.row.g-2
                  each consent, index in ['privacy', 'consent', 'terms']
                    .col-6
                      .form-check
                        input.form-check-input(
                          type="checkbox"
                          name="consents[]"
                          value=consent
                          checked=user.user_metadata.consents.includes(consent) ? 'checked' : false
                        )
                        label.form-check-label= consent.replace('_', ' ')

                .text-center.mt-4
                  button.btn.btn-primary(type="submit") 
                    | 🔒 Update Profile

      footer.text-center.mt-4
        p &copy; 2025 - Profile Management System

    else
      p.text-center You are not logged in.

  // Panel claiming functionality
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const claimPanelBtn = document.getElementById('claimPanelBtn');
      const refreshPanelBtn = document.getElementById('refreshPanelBtn');
      
      // Refresh panel status functionality
      if (refreshPanelBtn) {
        refreshPanelBtn.addEventListener('click', async function() {
          try {
            // Show loading state
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Refreshing...';
            
            // Make API call to refresh panel status
            const response = await fetch('/refresh-panel-status', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
            });
            
            const result = await response.json();
            
            if (response.ok && result.success) {
              // Show success message
              const alertDiv = document.createElement('div');
              alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3';
              alertDiv.innerHTML = `
                <i class="fas fa-check-circle me-2"></i>
                <strong>Status Refreshed!</strong>
                <p class="mb-0 mt-1">Panel status has been refreshed. Reloading page...</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              `;
              
              // Replace the claim section with success message
              const panelClaim = document.querySelector('.panel-claim');
              if (panelClaim) {
                panelClaim.parentNode.replaceChild(alertDiv, panelClaim);
              }
              
              // Reload page after 2 seconds
              setTimeout(() => {
                window.location.reload();
              }, 2000);
            } else {
              // Show error message
              const alertDiv = document.createElement('div');
              alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
              alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Refresh Failed</strong>
                <p class="mb-0 mt-1">${result.error || 'Failed to refresh panel status. Please try again.'}</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              `;
              
              const panelClaim = document.querySelector('.panel-claim');
              if (panelClaim) {
                panelClaim.appendChild(alertDiv);
              }
              
              // Reset button
              this.disabled = false;
              this.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Refresh Status';
            }
          } catch (error) {
            console.error('Error refreshing panel status:', error);
            
            // Show error message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
            alertDiv.innerHTML = `
              <i class="fas fa-exclamation-circle me-2"></i>
              <strong>Refresh Failed</strong>
              <p class="mb-0 mt-1">Network error. Please check your connection and try again.</p>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const panelClaim = document.querySelector('.panel-claim');
            if (panelClaim) {
              panelClaim.appendChild(alertDiv);
            }
            
            // Reset button
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Refresh Status';
          }
        });
      }
      
      // Claim panel functionality
      if (claimPanelBtn) {
        claimPanelBtn.addEventListener('click', async function() {
          try {
            // Show loading state
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Claiming Panel...';
            
            // Make API call to claim panel
            const response = await fetch('/claim-panel', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
            });
            
            const result = await response.json();
            
            if (response.ok && result.success) {
              // Show success message
              const alertDiv = document.createElement('div');
              alertDiv.className = 'alert alert-success alert-dismissible fade show mt-3';
              alertDiv.innerHTML = `
                <i class="fas fa-check-circle me-2"></i>
                <strong>Panel Claimed Successfully!</strong>
                <p class="mb-0 mt-1">You are now enrolled in the Nielsen Consumer Panel. Welcome!</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              `;
              
              // Replace the claim section with success message
              const panelClaim = document.querySelector('.panel-claim');
              if (panelClaim) {
                panelClaim.parentNode.replaceChild(alertDiv, panelClaim);
              }
              
              // Reload page after 3 seconds to show updated status
              setTimeout(() => {
                window.location.reload();
              }, 3000);
            } else {
              // Show error message
              const alertDiv = document.createElement('div');
              alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
              alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong>Error Claiming Panel</strong>
                <p class="mb-0 mt-1">${result.error || 'An unexpected error occurred. Please try again.'}</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              `;
              
              const panelClaim = document.querySelector('.panel-claim');
              if (panelClaim) {
                panelClaim.appendChild(alertDiv);
              }
              
              // Reset button
              this.disabled = false;
              this.innerHTML = '<i class="fas fa-user-plus me-2"></i>Claim Panel';
            }
          } catch (error) {
            console.error('Error claiming panel:', error);
            
            // Show error message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
            alertDiv.innerHTML = `
              <i class="fas fa-exclamation-circle me-2"></i>
              <strong>Error Claiming Panel</strong>
              <p class="mb-0 mt-1">Network error. Please check your connection and try again.</p>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            const panelClaim = document.querySelector('.panel-claim');
            if (panelClaim) {
              panelClaim.appendChild(alertDiv);
            }
            
            // Reset button
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-user-plus me-2"></i>Claim Panel';
          }
        });
      }
    });

    // Auto-dismiss profile update success message
    document.addEventListener('DOMContentLoaded', function() {
      const successMessage = document.getElementById('profileUpdateSuccess');
      if (successMessage) {
        // Auto-dismiss after 3 seconds
        setTimeout(() => {
          if (successMessage.parentNode) {
            successMessage.parentNode.removeChild(successMessage);
          }
        }, 3000);
      }
    });

extends layout

block content
  .content
    .container
      .upgrade-page
        h2.mb-4 Choose Your Plan
        
        if user
          .user-info.mb-4
            h4 Welcome, #{user.name || user.first_name || 'User'}
            p.text-muted Current tier: #{userTier}
        
        .plans-container
          .row
            .col-md-4
              .plan-card.free-plan
                .plan-header
                  h3 Basic
                  .price $0/month
                .plan-features
                  ul
                    li Basic phone service
                    li Standard data speeds
                    li Community support
                    li Basic device management
                .plan-action
                  button.btn.btn-secondary(disabled) Current Plan
            .col-md-4
              .plan-card.subscriber-plan
                .plan-header
                  h3 Unlimited
                  .price $45/month
                .plan-features
                  ul
                    li Unlimited talk, text & data
                    li 5G network access
                    li Mobile hotspot included
                    li Priority customer support
                    li Advanced device security
                .plan-action
                  form(action='/upgrade', method='POST')
                    input(type='hidden', name='tier', value='subscriber')
                    button.btn.btn-primary(type='submit') Upgrade to Unlimited
            .col-md-4
              .plan-card.premium-plan
                .plan-header
                  h3 Premium Plus
                  .price $75/month
                .plan-features
                  ul
                    li All Unlimited features
                    li Premium 5G+ speeds
                    li International roaming
                    li Device protection included
                    li Concierge support
                    li Advanced family controls
                .plan-action
                  form(action='/upgrade', method='POST')
                    input(type='hidden', name='tier', value='premium')
                    button.btn.btn-success(type='submit') Upgrade to Premium Plus
        
        .upgrade-info.mt-5
          .row
            .col-md-8.offset-md-2
              .info-card
                h4 Why Upgrade Your Healthcare Plan?
                p Upgrade your healthcare plan to unlock premium features and get the most out of our network.
                
                .features-grid
                  .row
                    .col-md-6
                      .feature-item
                        h5 Network Access
                        p Experience lightning-fast coverage
                    .col-md-6
                      .feature-item
                        h5 🔒 Advanced Security
                        p Enhanced device protection and privacy features
                    .col-md-6
                      .feature-item
                        h5 🌍 International Coverage
                        p Stay covered when traveling abroad
                    .col-md-6
                      .feature-item
                        h5 👨‍👩‍👧‍👦 Family Controls
                        p Manage and monitor your family's mobile usage 
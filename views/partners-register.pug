extends layout

block content
  .partners-register-page
    .register-hero
      .container
        .row.justify-content-center
          .col-lg-8
            .register-header
              h1.register-title Join Our Partner Network
              p.register-subtitle Become a partner and unlock new business opportunities
              
              if success
                .alert.alert-success.alert-dismissible.fade.show.mb-4
                  strong ✓ Registration Successful!
                  | Your partner organization has been created. You will receive an email with next steps.
                  button.btn-close(type="button" data-bs-dismiss="alert")
              
              if error
                .alert.alert-danger.alert-dismissible.fade.show.mb-4
                  strong ✗ Registration Failed
                  | #{error}
                  button.btn-close(type="button" data-bs-dismiss="alert")

    .register-form-section
      .container
        .row.justify-content-center
          .col-lg-10
            .register-form-card
              form#partnerRegistrationForm(action="/partners/register" method="POST")
                // Organization Information
                .form-section
                  .section-header
                    h3.section-title
                      i.fas.fa-building.me-2
                      | Organization Information
                    p.section-description Basic information needed to create your organization
                  
                  .row
                    .col-md-6
                      .form-group.mb-3
                        label.form-label(for="orgName") Organization Name *
                        input.form-control(
                          type="text"
                          id="orgName"
                          name="orgName"
                          required
                          placeholder="Enter your organization name"
                          value=formData && formData.orgName || ''
                        )
                        .form-text This will be the display name for your organization
                    
                    .col-md-6
                      .form-group.mb-3
                        label.form-label(for="orgDomain") Organization Domain *
                        input.form-control(
                          type="text"
                          id="orgDomain"
                          name="orgDomain"
                          required
                          placeholder="company.com"
                          value=formData && formData.orgDomain || ''
                        )
                        .form-text Your organization's primary domain (without www)

                // Contact Information
                .form-section
                  .section-header
                    h3.section-title
                      i.fas.fa-user.me-2
                      | Primary Contact
                    p.section-description The main contact person for this organization
                  
                  .row
                    .col-md-6
                      .form-group.mb-3
                        label.form-label(for="contactFirstName") First Name *
                        input.form-control(
                          type="text"
                          id="contactFirstName"
                          name="contactFirstName"
                          required
                          placeholder="Enter first name"
                          value=formData && formData.contactFirstName || ''
                        )
                    
                    .col-md-6
                      .form-group.mb-3
                        label.form-label(for="contactLastName") Last Name *
                        input.form-control(
                          type="text"
                          id="contactLastName"
                          name="contactLastName"
                          required
                          placeholder="Enter last name"
                          value=formData && formData.contactLastName || ''
                        )
                  
                  .form-group.mb-3
                    label.form-label(for="contactEmail") Email Address *
                    input.form-control(
                      type="email"
                      id="contactEmail"
                      name="contactEmail"
                      required
                      placeholder="contact@example.com"
                      value=formData && formData.contactEmail || ''
                    )
                    .form-text This will be the primary login email for the organization. You'll create your password when you accept the invitation.

                // Legal and Compliance
                .form-section
                  .section-header
                    h3.section-title
                      i.fas.fa-shield-alt.me-2
                      | Legal and Compliance
                    p.section-description Required legal information and agreements
                  
                  .form-group.mb-3
                    .form-check
                      input.form-check-input(type="checkbox" id="agreeTerms" name="agreeTerms" required)
                      label.form-check-label(for="agreeTerms")
                        | I agree to the
                        a(href="#" target="_blank") Partner Agreement
                        |  and
                        a(href="#" target="_blank") Terms of Service
                        |  *
                  
                  .form-group.mb-3
                    .form-check
                      input.form-check-input(type="checkbox" id="agreePrivacy" name="agreePrivacy" required)
                      label.form-check-label(for="agreePrivacy")
                        | I agree to the 
                        a(href="#" target="_blank") Privacy Policy
                        |  and consent to data processing *
                  
                  .form-group.mb-3
                    .form-check
                      input.form-check-input(type="checkbox" id="agreeMarketing" name="agreeMarketing")
                      label.form-check-label(for="agreeMarketing")
                        | I agree to receive marketing communications and partner program updates

                // Submit Section
                .form-section.submit-section
                  .submit-actions
                    button.btn.btn-register-primary.btn-lg(type="submit")
                      i.fas.fa-rocket.me-2
                      | Create Partner Organization
                    a.btn.btn-register-outline.btn-lg(href="/partners")
                      i.fas.fa-arrow-left.me-2
                      | Back to Partners
                  
                  .submit-note
                    p.text-muted
                      | By submitting this form, you agree to create a new partner organization in our network.
                      | You will receive an email confirmation and next steps within 24 hours.

  // Auto-dismiss alerts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const alerts = document.querySelectorAll('.alert');
      alerts.forEach(alert => {
        setTimeout(() => {
          if (alert.parentNode) {
            alert.parentNode.removeChild(alert);
          }
        }, 5000);
      });
    });

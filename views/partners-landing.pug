extends layout

block content
  .partners-page
    // Professional Hero Section
    .partners-hero-section
      .container
        .row.align-items-center.min-vh-75
          .col-lg-6
            .partners-hero-content
              .partners-badge
                span.badge-text Authorized Dealer Program
              h1.partners-main-title
                | Grow Your Business with 
                span.highlight Goodyear Partnership
              p.partners-hero-description
                | Join our exclusive dealer network and unlock new revenue opportunities, 
                | access premium tire products, and grow your business with the world's leading tire brand.
              .partners-cta-buttons
                if user && userTier === 'premium'
                  a.btn.btn-partners-primary.btn-lg(href='/partners/admin')
                    i.fas.fa-cog.me-2
                    | Admin Dashboard
                  a.btn.btn-partners-outline.btn-lg(href='/partners/login')
                    i.fas.fa-sign-in-alt.me-2
                    | Partner Login
                else if user
                  a.btn.btn-partners-primary.btn-lg(href='/partners/login')
                    i.fas.fa-sign-in-alt.me-2
                    | Partner Login
                  a.btn.btn-partners-outline.btn-lg(href='/partners/dashboard')
                    i.fas.fa-tachometer-alt.me-2
                    | My Dashboard
                else
                  a.btn.btn-partners-primary.btn-lg(href='/partners/login')
                    i.fas.fa-sign-in-alt.me-2
                    | Partner Login
                  a.btn.btn-partners-outline.btn-lg(href='/partners/register')
                    i.fas.fa-handshake.me-2
                    | Become a Partner
              .partners-trust-indicators
                .trust-item
                  span.trust-number 2,500+
                  span.trust-label Authorized Dealers
                .trust-item
                  span.trust-number 120+
                  span.trust-label Years of Excellence
                .trust-item
                  span.trust-number #1
                  span.trust-label Tire Brand Globally
          .col-lg-6
            .partners-hero-visual
              .partners-visual-card
                .visual-header
                  .visual-icon
                    i.fas.fa-chart-line
                  h4 Partner Dashboard
                .visual-content
                  .metric-row
                    .metric
                      .metric-value $185K
                      .metric-label Monthly Tire Sales
                    .metric
                      .metric-value 1,250
                      .metric-label Units Sold
                  .chart-placeholder
                    .chart-bar(style="height: 60%")
                    .chart-bar(style="height: 80%")
                    .chart-bar(style="height: 45%")
                    .chart-bar(style="height: 90%")
                    .chart-bar(style="height: 70%")

    // Admin Section (Premium Users Only)
    if user && userTier === 'premium'
      .partners-admin-section
        .container
          .admin-banner
            .admin-content
              .admin-badge
                i.fas.fa-crown.me-2
                span.badge-text Partner Administrator
              h2.admin-title Welcome, #{user.name || 'Admin'}
              p.admin-description Access advanced partner management tools and administrative functions.
              .admin-actions
                a.btn.btn-admin-primary(href='/partners/admin/dashboard')
                  i.fas.fa-tachometer-alt.me-2
                  | Admin Dashboard
                a.btn.btn-admin-outline(href='/partners/admin/partners')
                  i.fas.fa-users.me-2
                  | Manage Partners
                a.btn.btn-admin-outline(href='/partners/admin/analytics')
                  i.fas.fa-chart-bar.me-2
                  | Analytics
                a.btn.btn-admin-outline(href='/partners/admin/settings')
                  i.fas.fa-cog.me-2
                  | Settings

    // Partnership Tiers Section
    .partners-tiers-section
      .container
        .section-header
          h2.section-title Dealer Partnership Tiers
          p.section-subtitle Choose the dealer level that fits your business needs
        .row
          .col-lg-4
            .tier-card.tier-bronze
              .tier-header
                .tier-icon
                  i.fas.fa-store
                h3.tier-name Authorized Dealer
                .tier-price
                  span.price Free
                  span.period to join
              .tier-features
                ul
                  li Access to full tire catalog
                  li Dealer portal access
                  li Standard training materials
                  li Marketing support
              .tier-cta
                a.btn.btn-tier(href='/partners/register?tier=bronze') Get Started
          .col-lg-4
            .tier-card.tier-silver.featured
              .tier-badge Most Popular
              .tier-header
                .tier-icon
                  i.fas.fa-award
                h3.tier-name Premium Dealer
                .tier-price
                  span.price $499
                  span.period /month
              .tier-features
                ul
                  li All Authorized features
                  li Priority inventory access
                  li Advanced training programs
                  li Co-branded marketing
                  li Volume discounts (10%)
              .tier-cta
                a.btn.btn-tier.btn-tier-primary(href='/partners/register?tier=silver') Upgrade Now
          .col-lg-4
            .tier-card.tier-gold
              .tier-header
                .tier-icon
                  i.fas.fa-crown
                h3.tier-name Elite Dealer
                .tier-price
                  span.price Custom
                  span.period pricing
              .tier-features
                ul
                  li All Premium features
                  li Dedicated account manager
                  li Exclusive product launches
                  li Higher volume discounts (15%)
                  li Regional territory rights
              .tier-cta
                a.btn.btn-tier(href='/partners/register?tier=gold') Contact Sales

    // Success Stories Section
    .partners-success-section
      .container
        .section-header
          h2.section-title Dealer Success Stories
          p.section-subtitle See how our dealers are growing their businesses
        .row
          .col-lg-4
            .success-card
              .success-logo
                img(src='/static/images/partner-logo-1.png', alt='City Tire Center', onerror="this.style.display='none'")
                .fallback-logo CT
              .success-content
                h4 City Tire Center
                p.success-quote "Becoming a Goodyear dealer increased our revenue by 250% in the first year."
                .success-metrics
                  .metric
                    span.metric-value 250%
                    span.metric-label Revenue Growth
                  .metric
                    span.metric-value $3.2M
                    span.metric-label Annual Revenue
          .col-lg-4
            .success-card
              .success-logo
                img(src='/static/images/partner-logo-2.png', alt='Auto Service Pro', onerror="this.style.display='none'")
                .fallback-logo AS
              .success-content
                h4 Auto Service Pro
                p.success-quote "The dealer support and training helped us expand to 8 locations in 3 years."
                .success-metrics
                  .metric
                    span.metric-value 8
                    span.metric-label Locations
                  .metric
                    span.metric-value 180%
                    span.metric-label Customer Growth
          .col-lg-4
            .success-card
              .success-logo
                img(src='/static/images/partner-logo-3.png', alt='Highway Tire Shop', onerror="this.style.display='none'")
                .fallback-logo HT
              .success-content
                h4 Highway Tire Shop
                p.success-quote "Goodyear's premium tire selection and marketing support transformed our business."
                .success-metrics
                  .metric
                    span.metric-value 4x
                    span.metric-label Sales Increase
                  .metric
                    span.metric-value 98%
                    span.metric-label Customer Satisfaction

    // Resources Section
    .partners-resources-section
      .container
        .section-header
          h2.section-title Dealer Resources
          p.section-subtitle Everything you need to succeed as a Goodyear dealer
        .row
          .col-lg-3.col-md-6
            .resource-card
              .resource-icon
                i.fas.fa-book
              h4.resource-title Product Catalog
              p.resource-description Complete tire specifications and inventory guides
              a.resource-link(href='#') View Catalog →
          .col-lg-3.col-md-6
            .resource-card
              .resource-icon
                i.fas.fa-graduation-cap
              h4.resource-title Training
              p.resource-description Tire installation and service certification programs
              a.resource-link(href='#') Start Learning →
          .col-lg-3.col-md-6
            .resource-card
              .resource-icon
                i.fas.fa-bullhorn
              h4.resource-title Marketing
              p.resource-description Co-branded materials and promotional campaigns
              a.resource-link(href='#') Get Materials →
          .col-lg-3.col-md-6
            .resource-card
              .resource-icon
                i.fas.fa-users
              h4.resource-title Dealer Network
              p.resource-description Connect with other dealers and share best practices
              a.resource-link(href='#') Join Network →

    // CTA Section
    .partners-cta-section
      .container
        .cta-content
          h2.cta-title Ready to Become a Goodyear Dealer?
          p.cta-description Join thousands of successful dealers and start growing your tire business today.
          .cta-buttons
            a.btn.btn-cta-primary.btn-lg(href='/partners/register')
              i.fas.fa-rocket.me-2
              | Become a Dealer
            a.btn.btn-cta-outline.btn-lg(href='/partners/contact')
              i.fas.fa-phone.me-2
              | Contact Sales

    // Partners Footer
    footer.partners-footer
      .footer-container
        .footer-content
          .footer-section
            h4.footer-title Dealer Resources
            ul.footer-links
              li: a(href='#') Dealer Portal
              li: a(href='#') Product Catalog
              li: a(href='#') Training Materials
              li: a(href='#') Support Center
              li: a(href='#') Partner Directory
          
          .footer-section
            h4.footer-title Programs
            ul.footer-links
              li: a(href='#') Technology Partners
              li: a(href='#') Channel Partners
              li: a(href='#') Solution Partners
              li: a(href='#') Integration Partners
              li: a(href='#') Referral Program
          
          .footer-section
            h4.footer-title Support
            ul.footer-links
              li: a(href='#') Partner Support
              li: a(href='#') Technical Support
              li: a(href='#') Account Management
              li: a(href='#') Billing Support
              li: a(href='#') Partner Success
          
          .footer-section
            h4.footer-title Legal
            ul.footer-links
              li: a(href='#') Partner Agreement
              li: a(href='#') Terms of Service
              li: a(href='#') Privacy Policy
              li: a(href='#') Compliance
              li: a(href='#') Legal Notices
          
          .footer-section
            h4.footer-title Connect
            ul.footer-links
              li: a(href='#') Partner Events
              li: a(href='#') Newsletter
              li: a(href='#') Community
              li: a(href='#') Partner Blog
              li: a(href='#') Contact Us
        
        .footer-bottom
          .footer-bottom-content
            p.footer-copyright © 2024 AT&T Partner Portal. All rights reserved.
            .footer-bottom-links
              a(href='#') Privacy
              a(href='#') Terms
              a(href='#') Accessibility
              a(href='#') Sitemap

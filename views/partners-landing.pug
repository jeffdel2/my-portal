extends layout

block content
  - const config = branding || {}
  .partners-page
    // Professional Hero Section
    .partners-hero-section
      .container
        .row.align-items-center.min-vh-75
          .col-lg-6
            .partners-hero-content
              .partners-badge
                span.badge-text Partner Program
              h1.partners-main-title
                | Grow Your Business with
                span.highlight= ' ' + (config.companyName || 'Partner Portal')
              p.partners-hero-description
                = config.description || 'Empowering business partnerships through innovative technology and dedicated support. Join thousands of partners who trust our platform to grow their business.'
              .partners-cta-buttons
                if user && userTier === 'premium'
                  a.btn.btn-partners-primary.btn-lg(href='/partners/admin')
                    i.fas.fa-cog.me-2
                    | Admin Dashboard
                  a.btn.btn-partners-outline.btn-lg(href='/partners/login')
                    i.fas.fa-sign-in-alt.me-2
                    | Login
                else if user
                  a.btn.btn-partners-primary.btn-lg(href='/partners/login')
                    i.fas.fa-sign-in-alt.me-2
                    | Login
                  a.btn.btn-partners-outline.btn-lg(href='/partners/dashboard')
                    i.fas.fa-tachometer-alt.me-2
                    | My Dashboard
                else
                  a.btn.btn-partners-primary.btn-lg(href='/partners/login')
                    i.fas.fa-sign-in-alt.me-2
                    | Login
                  a.btn.btn-partners-outline.btn-lg(href='/partners/register')
                    i.fas.fa-handshake.me-2
                    | Become a Partner
              .partners-trust-indicators
                .trust-item
                  span.trust-number= (config.statistics && config.statistics.networkPartners) || '5,000+'
                  span.trust-label Network Partners
                .trust-item
                  span.trust-number= (config.statistics && config.statistics.yearsInBusiness) || '25+'
                  span.trust-label Years of Excellence
                .trust-item
                  span.trust-number= (config.statistics && config.statistics.marketPosition) || '#1'
                  span.trust-label= (config.statistics && config.statistics.marketPosition) ? 'Platform' : 'Platform'
          .col-lg-6
            .partners-hero-visual
              .partners-visual-card
                .visual-header
                  .visual-icon
                    i.fas.fa-chart-line
                  h4 Partner Dashboard
                .visual-content
                  .metric-row
                    .metric
                      .metric-value= (config.sampleMetrics && config.sampleMetrics.revenue) || '$185K'
                      .metric-label= (config.sampleMetrics && config.sampleMetrics.revenueLabel) || 'Monthly Revenue'
                    .metric
                      .metric-value= (config.sampleMetrics && config.sampleMetrics.leads) || '1,250'
                      .metric-label= (config.sampleMetrics && config.sampleMetrics.leadsLabel) || 'Active Leads'
                  .chart-placeholder
                    .chart-bar(style="height: 60%")
                    .chart-bar(style="height: 80%")
                    .chart-bar(style="height: 45%")
                    .chart-bar(style="height: 90%")
                    .chart-bar(style="height: 70%")

    // Admin Section (Premium Users Only)
    if user && userTier === 'premium'
      .partners-admin-section
        .container
          .admin-banner
            .admin-content
              .admin-badge
                i.fas.fa-crown.me-2
                span.badge-text Partner Administrator
              h2.admin-title Welcome, #{user.name || 'Admin'}
              p.admin-description Access advanced partner management tools and administrative functions.
              .admin-actions
                a.btn.btn-admin-primary(href='/partners/admin/dashboard')
                  i.fas.fa-tachometer-alt.me-2
                  | Admin Dashboard
                a.btn.btn-admin-outline(href='/partners/admin/partners')
                  i.fas.fa-users.me-2
                  | Manage Partners
                a.btn.btn-admin-outline(href='/partners/admin/analytics')
                  i.fas.fa-chart-bar.me-2
                  | Analytics
                a.btn.btn-admin-outline(href='/partners/admin/settings')
                  i.fas.fa-cog.me-2
                  | Settings

    // Partnership Tiers Section
    .partners-tiers-section
      .container
        .section-header
          h2.section-title Partnership Tiers
          p.section-subtitle Choose the partnership level that fits your business needs
        .row
          - const tiers = config.partnerTiers || {}
          - const bronze = tiers.bronze || {}
          - const silver = tiers.silver || {}
          - const gold = tiers.gold || {}

          .col-lg-4
            .tier-card.tier-bronze
              .tier-header
                .tier-icon
                  i(class='fas ' + (bronze.icon || 'fa-award'))
                h3.tier-name= bronze.name || 'Standard Partner'
                .tier-price
                  span.price= bronze.price || 'Free'
                  span.period to join
              .tier-features
                ul
                  if bronze.features
                    each feature in bronze.features
                      li= feature
                  else
                    li Access to partner portal
                    li Basic marketplace listing
                    li Monthly performance reports
                    li Email support
              .tier-cta
                a.btn.btn-tier(href='/partners/register?tier=bronze') Get Started
          .col-lg-4
            .tier-card.tier-silver.featured
              .tier-badge(class=silver.badge) Most Popular
              .tier-header
                .tier-icon
                  i(class='fas ' + (silver.icon || 'fa-medal'))
                h3.tier-name= silver.name || 'Premium Partner'
                .tier-price
                  span.price= silver.price || '$499'
                  span.period /month
              .tier-features
                ul
                  if silver.features
                    each feature in silver.features
                      li= feature
                  else
                    li All Standard features
                    li Featured marketplace placement
                    li Priority lead distribution
                    li Priority support
              .tier-cta
                a.btn.btn-tier.btn-tier-primary(href='/partners/register?tier=silver') Upgrade Now
          .col-lg-4
            .tier-card.tier-gold
              .tier-header
                .tier-icon
                  i(class='fas ' + (gold.icon || 'fa-crown'))
                h3.tier-name= gold.name || 'Elite Partner'
                .tier-price
                  span.price= gold.price || 'Custom'
                  span.period pricing
              .tier-features
                ul
                  if gold.features
                    each feature in gold.features
                      li= feature
                  else
                    li All Premium features
                    li Dedicated account manager
                    li Exclusive opportunities
                    li Custom API integrations
              .tier-cta
                a.btn.btn-tier(href='/partners/register?tier=gold') Contact Sales

    // Success Stories Section
    .partners-success-section
      .container
        .section-header
          h2.section-title Partner Success Stories
          p.section-subtitle See how our partners are growing their businesses
        .row
          - const stories = config.successStories || []
          if stories.length > 0
            each story, index in stories.slice(0, 3)
              .col-lg-4
                .success-card
                  .success-logo
                    .fallback-logo= story.company.substring(0, 2).toUpperCase()
                  .success-content
                    h4= story.company
                    .success-tier
                      span.badge.bg-primary= story.tier
                    p.success-quote= story.testimonial
                    .success-metrics
                      if story.metrics
                        .metric
                          span.metric-value= story.metrics.revenue || story.metrics.growth
                          span.metric-label Revenue Growth
                        .metric
                          span.metric-value= story.metrics.leads
                          span.metric-label Active Leads
                    if story.contact
                      .success-contact
                        strong= story.contact.name
                        br
                        span= story.contact.title
          else
            .col-lg-4
              .success-card
                .success-logo
                  .fallback-logo TS
                .success-content
                  h4 TechSolutions Inc
                  p.success-quote "Partnering with this platform has transformed our business."
                  .success-metrics
                    .metric
                      span.metric-value +300%
                      span.metric-label Growth
                    .metric
                      span.metric-value $2.4M
                      span.metric-label Revenue
            .col-lg-4
              .success-card
                .success-logo
                  .fallback-logo GS
                .success-content
                  h4 Global Services Group
                  p.success-quote "The partner portal's tools have been exceptional."
                  .success-metrics
                    .metric
                      span.metric-value +175%
                      span.metric-label Growth
                    .metric
                      span.metric-value $850K
                      span.metric-label Revenue
            .col-lg-4
              .success-card
                .success-logo
                  .fallback-logo ES
                .success-content
                  h4 Enterprise Solutions Co
                  p.success-quote "Outstanding platform with incredible support."
                  .success-metrics
                    .metric
                      span.metric-value +240%
                      span.metric-label Growth
                    .metric
                      span.metric-value $1.8M
                      span.metric-label Revenue

    // Resources Section
    .partners-resources-section
      .container
        .section-header
          h2.section-title Partner Resources
          p.section-subtitle Everything you need to succeed as a partner
        .row
          - const resources = config.resources || []
          if resources.length > 0
            each resource in resources
              .col-lg-3.col-md-6
                .resource-card
                  .resource-icon
                    i(class='fas ' + (resource.icon || 'fa-book'))
                  h4.resource-title= resource.title
                  p.resource-description= resource.description
                  a.resource-link(href='#') Learn More →
          else
            .col-lg-3.col-md-6
              .resource-card
                .resource-icon
                  i.fas.fa-book
                h4.resource-title Partner Directory
                p.resource-description Browse our complete network of partners
                a.resource-link(href='#') View Directory →
            .col-lg-3.col-md-6
              .resource-card
                .resource-icon
                  i.fas.fa-graduation-cap
                h4.resource-title Training Programs
                p.resource-description Access comprehensive training materials
                a.resource-link(href='#') Start Learning →
            .col-lg-3.col-md-6
              .resource-card
                .resource-icon
                  i.fas.fa-bullhorn
                h4.resource-title Marketing Support
                p.resource-description Leverage co-marketing opportunities
                a.resource-link(href='#') Get Materials →
            .col-lg-3.col-md-6
              .resource-card
                .resource-icon
                  i.fas.fa-users
                h4.resource-title Partner Network
                p.resource-description Connect with other partners
                a.resource-link(href='#') Join Network →

    // CTA Section
    .partners-cta-section
      .container
        .cta-content
          h2.cta-title Ready to Join Our Partner Network?
          p.cta-description Join thousands of successful partners and start growing your business today.
          .cta-buttons
            a.btn.btn-cta-primary.btn-lg(href='/partners/register')
              i.fas.fa-rocket.me-2
              | Become a Partner
            a.btn.btn-cta-outline.btn-lg(href='/partners/contact')
              i.fas.fa-phone.me-2
              | Contact Sales

    // Partners Footer
    footer.partners-footer
      .footer-container
        .footer-content
          - const footerSections = (config.footer && config.footer.sections) || {}
          each section in footerSections
            .footer-section
              h4.footer-title= section.title
              ul.footer-links
                each link in section.links
                  li: a(href=link.url)= link.text

        .footer-bottom
          .footer-bottom-content
            p.footer-copyright= '© ' + new Date().getFullYear() + ' ' + ((config.footer && config.footer.copyright) || 'Partner Portal. All rights reserved.')
            .footer-bottom-links
              a(href='#') Privacy
              a(href='#') Terms
              a(href='#') Accessibility
              a(href='#') Sitemap

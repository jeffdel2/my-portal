extends layout

block content
  .partners-dashboard-page
    .container
      // Dashboard Header
      .dashboard-header.mb-5
        .row.align-items-center
          .col-md-8
            h1.dashboard-title Organization Dashboard
            p.dashboard-subtitle Manage your organization members and settings
          .col-md-4.text-end
            .org-info
              .org-badge
                i.fas.fa-building.me-2
                span= organization.display_name || orgName
              .org-meta
                small.text-muted #{members && members.length ? members.length : 0} active member#{members && members.length !== 1 ? 's' : ''}, #{invitations && invitations.length ? invitations.length : 0} pending invitation#{invitations && invitations.length !== 1 ? 's' : ''}

      .row
        // Left Column - Invite New User
        .col-lg-3
          .dashboard-card
            .card-header
              h3.card-title
                i.fas.fa-user-plus.me-2
                | Invite New User
              p.card-subtitle Add a new member to your organization
            
            .card-body
              form#inviteUserForm
                .form-group.mb-3
                  label.form-label(for="email") Email Address *
                  input.form-control(
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="user@example.com"
                  )
                
                .form-group.mb-3
                  label.form-label(for="role") Role
                  select.form-control(id="role" name="role")
                    option(value="org-user") Organization User
                    option(value="org-admin") Organization Admin
                
                .form-actions
                  button.btn.btn-primary.btn-lg.w-100(type="submit")
                    i.fas.fa-paper-plane.me-2
                    | Send Invitation
                
                .invite-status.mt-3
                  #inviteSuccess.alert.alert-success(style="display: none;")
                    i.fas.fa-check-circle.me-2
                    span#successMessage
                  
                  #inviteError.alert.alert-danger(style="display: none;")
                    i.fas.fa-exclamation-circle.me-2
                    span#errorMessage

        // Right Column - Organization Members and Invitations
        .col-lg-9
          // Active Members Section
          .dashboard-card.mb-4
            .card-header
              h3.card-title
                i.fas.fa-users.me-2
                | Active Members
              p.card-subtitle Members who have accepted their invitations
              if userPermissions && userPermissions.includes('org:admin')
                small.text-muted.d-block
                  i.fas.fa-info-circle.me-1
                  | Note: Other organization admins are hidden from this view
            
            .card-body
              if members && Array.isArray(members) && members.length > 0
                .members-list
                  each member in members
                    .member-item
                      .member-avatar
                        .avatar-circle
                          = (member.name || member.email || member.user_id || 'U').charAt(0).toUpperCase()
                      .member-info
                        .member-name= member.name || member.email || member.user_id || 'Unknown User'
                        .member-email= member.email || member.user_id || 'No email'
                        .member-meta
                          small.text-muted Member since: #{new Date(member.created_at || Date.now()).toLocaleDateString()}
                      .member-actions
                        .member-status
                          span.badge.badge-success
                            i.fas.fa-check.me-1
                            | Active
                        .member-role
                          // Show permissions-based role for current user, generic for others
                          if member.user_id === user.sub
                            if userPermissions && userPermissions.includes('org:admin')
                              span.badge.badge-info Organization Admin
                            else if userPermissions && userPermissions.includes('org:user')
                              span.badge.badge-info Organization User
                            else
                              span.badge.badge-secondary Organization User
                          else
                            span.badge.badge-secondary Organization Member
              else
                .empty-state
                  .empty-icon
                    i.fas.fa-users
                  h4.empty-title No Active Members
                  p.empty-description Members will appear here once they accept their invitations.

          // Pending Invitations Section
          .dashboard-card.mb-4
            .card-header
              h3.card-title
                i.fas.fa-envelope.me-2
                | Pending Invitations
              p.card-subtitle Invitations that haven't been accepted yet
            
            .card-body
              if invitations && Array.isArray(invitations) && invitations.length > 0
                .members-list
                  each invitation in invitations
                    .member-item
                      .member-avatar
                        .avatar-circle
                          = (invitation.invitee.email || 'I').charAt(0).toUpperCase()
                      .member-info
                        .member-name= invitation.invitee.email || 'Unknown Email'
                        .member-email= invitation.invitee.email || 'No email'
                        .member-meta
                          small.text-muted Invited: #{new Date(invitation.created_at).toLocaleDateString()}
                          if invitation.ttl_sec
                            - var expiresAt = new Date(new Date(invitation.created_at).getTime() + (invitation.ttl_sec * 1000))
                            small.text-muted.d-block Expires: #{expiresAt.toLocaleDateString()}
                      .member-actions
                        .member-status
                          span.badge.badge-warning
                            i.fas.fa-clock.me-1
                            | Pending
                        .member-role
                          // Invitations don't have permissions until accepted
                          span.badge.badge-secondary Pending Invitation
              else
                .empty-state
                  .empty-icon
                    i.fas.fa-envelope
                  h4.empty-title No Pending Invitations
                  p.empty-description All invitations have been accepted or none have been sent yet.

            // Self-Service SSO Section (Only for org-admins)
            if userPermissions && userPermissions.includes('org:admin')
              .dashboard-card
                .card-header
                  h3.card-title
                    i.fas.fa-shield-alt.me-2
                    | Self-Service SSO
                  p.card-subtitle Enable enterprise identity provider connections for your organization
                
                .card-body
                  .sso-info.mb-4
                    .alert.alert-info
                      i.fas.fa-info-circle.me-2
                      | Connect your organization's existing identity provider (like Active Directory, Okta, or Google Workspace) to enable seamless single sign-on for all your users.
                  
                  .sso-request-section.text-center
                    .sso-icon.mb-3
                      i.fas.fa-shield-alt.fa-3x.text-primary
                    
                    h5.mb-3 Enable Self-Service SSO
                      p.text-muted.mb-4
                        | Request access to configure your organization's enterprise identity provider.
                    
                  button#ssoRequestBtn.btn.btn-primary.btn-lg(type="button")
                    i.fas.fa-rocket.me-2
                    | Request SSO Access
                  
                  .sso-status.mt-4
                    #ssoSuccess.alert.alert-success(style="display: none;")
                      i.fas.fa-check-circle.me-2
                      span#ssoSuccessMessage
                      .mt-3
                        strong Ticket ID: 
                        span#ssoTicketId.text-monospace
                        .mt-2
                          a#ssoTicketLink.btn.btn-outline-success.btn-sm(href="#", target="_blank", style="display: none;")
                            i.fas.fa-external-link-alt.me-1
                            | Access IDP Onboarding Ticket
                    
                    #ssoError.alert.alert-danger(style="display: none;")
                      i.fas.fa-exclamation-circle.me-2
                      span#ssoErrorMessage
                  
                  // Persistent Ticket Display
                  #ssoTicketDisplay.card.mt-4(style="display: none;")
                    .card-header.bg-info.text-white.d-flex.justify-content-between.align-items-center
                      h6.mb-0
                        i.fas.fa-ticket-alt.me-2
                        | Active SSO Ticket
                      button#clearTicketBtn.btn.btn-sm.btn-outline-light(type="button")
                        i.fas.fa-times.me-1
                        | Clear
                    .card-body
                      .row
                        .col-md-6
                          .mb-2
                            strong.text-muted Ticket ID:
                            .text-monospace.bg-light.p-2.rounded.mt-1#persistentTicketId
                          .mb-2
                            strong.text-muted Status:
                            .badge.bg-warning.text-dark.mt-1#ticketStatus Pending
                        .col-md-6
                          .mb-2
                            strong.text-muted Created:
                            .text-muted.mt-1#ticketCreated
                          .mb-2
                            strong.text-muted Action:
                            .mt-1
                              a#persistentTicketLink.btn.btn-primary.btn-sm(href="#", target="_blank")
                                i.fas.fa-external-link-alt.me-1
                                | Access IDP Onboarding
                      .mt-3.p-2.bg-light.rounded
                        .small.text-muted
                          i.fas.fa-info-circle.me-1
                          | This ticket will remain active until you clear it or complete the IDP onboarding process.

      // Organization Settings (Future Enhancement)
      .row.mt-5
        .col-12
          .dashboard-card
            .card-header
              h3.card-title
                i.fas.fa-cog.me-2
                | Organization Settings
              p.card-subtitle Configure your organization preferences
            
            .card-body
              .settings-grid
                .setting-item
                  .setting-icon
                    i.fas.fa-shield-alt
                  .setting-content
                    h5.setting-title Security Settings
                    p.setting-description Configure authentication and security policies
                    button.btn.btn-outline-primary.btn-sm Manage Security
                
                .setting-item
                  .setting-icon
                    i.fas.fa-database
                  .setting-content
                    h5.setting-title Data Management
                    p.setting-description Manage user data and privacy settings
                    button.btn.btn-outline-primary.btn-sm Manage Data
                
                .setting-item
                  .setting-icon
                    i.fas.fa-chart-bar
                  .setting-content
                    h5.setting-title Analytics
                    p.setting-description View organization usage and activity
                    button.btn.btn-outline-primary.btn-sm View Analytics

  // JavaScript for form handling
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('inviteUserForm');
      const successAlert = document.getElementById('inviteSuccess');
      const errorAlert = document.getElementById('inviteError');
      const successMessage = document.getElementById('successMessage');
      const errorMessage = document.getElementById('errorMessage');
      
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Hide previous alerts
        successAlert.style.display = 'none';
        errorAlert.style.display = 'none';
        
        // Get form data
        const formData = new FormData(form);
        const data = {
          email: formData.get('email'),
          role: formData.get('role')
        };
        
        try {
          const response = await fetch('/partners/dashboard/invite', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
          });
          
          const result = await response.json();
          
          if (result.success) {
            successMessage.textContent = result.message;
            successAlert.style.display = 'block';
            form.reset(); // Clear the form
            
            // Auto-hide success message after 5 seconds
            setTimeout(() => {
              successAlert.style.display = 'none';
            }, 5000);
          } else {
            errorMessage.textContent = result.error;
            errorAlert.style.display = 'block';
          }
        } catch (error) {
          console.error('Error sending invitation:', error);
          errorMessage.textContent = 'An unexpected error occurred. Please try again.';
          errorAlert.style.display = 'block';
        }
      });

      // SSO Request Button Handling
      const ssoRequestBtn = document.getElementById('ssoRequestBtn');
      
      if (ssoRequestBtn) {
        const ssoSuccessAlert = document.getElementById('ssoSuccess');
        const ssoErrorAlert = document.getElementById('ssoError');
        const ssoSuccessMessage = document.getElementById('ssoSuccessMessage');
        const ssoErrorMessage = document.getElementById('ssoErrorMessage');
        
        ssoRequestBtn.addEventListener('click', async function(e) {
          e.preventDefault();
          
          // Disable button and show loading state
          ssoRequestBtn.disabled = true;
          ssoRequestBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
          
          // Hide previous alerts
          ssoSuccessAlert.style.display = 'none';
          ssoErrorAlert.style.display = 'none';
          
          try {
            const response = await fetch('/partners/dashboard/sso-request', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({})
            });
            
            const result = await response.json();
            
            if (result.success) {
              ssoSuccessMessage.textContent = result.message;
              
              // Display ticket information if available
              if (result.ticketId) {
                document.getElementById('ssoTicketId').textContent = result.ticketId;
                
                // Use the Auth0 ticket URL returned from the server
                if (result.ticketUrl) {
                  const ticketLink = document.getElementById('ssoTicketLink');
                  ticketLink.href = result.ticketUrl;
                  ticketLink.textContent = 'Access IDP Onboarding Ticket';
                  ticketLink.style.display = 'inline-block';
                  
                  // Store ticket info in localStorage for persistence
                  const ticketInfo = {
                    ticketId: result.ticketId,
                    ticketUrl: result.ticketUrl,
                    createdAt: new Date().toISOString(),
                    status: 'pending'
                  };
                  localStorage.setItem('ssoTicket', JSON.stringify(ticketInfo));
                  
                  // Show persistent ticket display
                  showPersistentTicket(ticketInfo);
                }
              }
              
              ssoSuccessAlert.style.display = 'block';
              
              // Auto-hide success message after 5 seconds (ticket info is now persistent)
              setTimeout(() => {
                ssoSuccessAlert.style.display = 'none';
              }, 5000);
            } else {
              ssoErrorMessage.textContent = result.error;
              ssoErrorAlert.style.display = 'block';
            }
        } catch (error) {
          ssoErrorMessage.textContent = 'An unexpected error occurred. Please try again.';
          ssoErrorAlert.style.display = 'block';
        } finally {
            // Re-enable button
            ssoRequestBtn.disabled = false;
            ssoRequestBtn.innerHTML = '<i class="fas fa-rocket me-2"></i>Request SSO Access';
          }
        });
      }
      
      // Function to show persistent ticket display
      function showPersistentTicket(ticketInfo) {
        const ticketDisplay = document.getElementById('ssoTicketDisplay');
        const persistentTicketId = document.getElementById('persistentTicketId');
        const persistentTicketLink = document.getElementById('persistentTicketLink');
        const ticketCreated = document.getElementById('ticketCreated');
        
        persistentTicketId.textContent = ticketInfo.ticketId;
        persistentTicketLink.href = ticketInfo.ticketUrl;
        ticketCreated.textContent = new Date(ticketInfo.createdAt).toLocaleString();
        
        ticketDisplay.style.display = 'block';
      }
      
      // Function to clear persistent ticket
      function clearPersistentTicket() {
        localStorage.removeItem('ssoTicket');
        document.getElementById('ssoTicketDisplay').style.display = 'none';
      }
      
      // Check for existing ticket on page load
      const existingTicket = localStorage.getItem('ssoTicket');
      if (existingTicket) {
        try {
          const ticketInfo = JSON.parse(existingTicket);
          showPersistentTicket(ticketInfo);
        } catch (error) {
          localStorage.removeItem('ssoTicket');
        }
      }
      
      // Handle clear ticket button
      const clearTicketBtn = document.getElementById('clearTicketBtn');
      if (clearTicketBtn) {
        clearTicketBtn.addEventListener('click', clearPersistentTicket);
      }
    });


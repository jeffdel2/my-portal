        script.
          // JavaScript for the slide-out functionality
          function openSlideout() {
            document.getElementById("mySlideout").style.width = "500px";
          }

          function closeSlideout() {
            document.getElementById("mySlideout").style.width = "0";
          }
          
          
          async function toggleMfaOptin(checkbox) {
            try {
              const optinmfa = checkbox.checked ? 'true' : 'false';
              
              const response = await fetch('/toggle-mfa-optin', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({ optinmfa: optinmfa })
              });
              
              const result = await response.json();
              
              if (result.success) {
                // Show success message
                const message = document.createElement('div');
                message.className = 'alert alert-success alert-dismissible fade show mt-2';
                message.innerHTML = `
                  ${result.message}
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                checkbox.closest('.mfa-optin-section').appendChild(message);
                
                // Remove the message after 3 seconds
                setTimeout(() => {
                  if (message.parentNode) {
                    message.parentNode.removeChild(message);
                  }
                }, 3000);
              } else {
                // Revert checkbox state on error
                checkbox.checked = !checkbox.checked;
                alert('Failed to update MFA setting: ' + (result.error || 'Unknown error'));
              }
            } catch (error) {
              // Revert checkbox state on error
              checkbox.checked = !checkbox.checked;
              console.error('Error toggling MFA opt-in:', error);
              alert('Failed to update MFA setting. Please try again.');
            }
          }
